# Đường dẫn SQLite (mặc định data/vnlisten.db)
VNLISTEN_DB=data/vnlisten.db
# Thư mục chứa taxonomy các ngành (mỗi ngành 1 file YAML)
VNLISTEN_INDUSTRIES_DIR=config/industries

# YouTube Data API v3 – miễn phí 10.000 units/ngày (Google Cloud Console)
YOUTUBE_API_KEY=

# Telegram bot để nhận cảnh báo – miễn phí (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM local qua Ollama (free). Để trống => dùng insight rule-based
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b

# ---- Social media không cần API (miễn phí) ----
# 1) Browser extension "VN Listen Capture" (thư mục extension/) gửi bài về: vnlisten serve
#    Token tuỳ chọn – nếu đặt, nhập cùng giá trị trong popup của extension
VNLISTEN_INGEST_TOKEN=
# 2) Tìm bài public qua công cụ tìm kiếm (site:facebook.com/groups ...)
#    SearXNG tự host (khuyên dùng): docker run -p 8888:8080 searxng/searxng
SEARXNG_URL=
#    hoặc Google Programmable Search (100 truy vấn/ngày free, nếu tài khoản còn tạo được)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
